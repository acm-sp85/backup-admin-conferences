ic/ckeditor/3ce0d501d1df3ec3323e1422addf8b38\"\r\n                        alt=\"One Mind\" width=\"50\" height=\"17\"\r\n                        style=\"max-height: 17px; max-width: 50px; object-fit: contain; margin: 0 8px; display: inline-block; vertical-align: middle;\" />\r\n                    <img src=\"https://es.app.scitoevents.com/static/ckeditor/67a9cfc6402b5d1437a4f52c0a71786e\"\r\n                        alt=\"Veratech\" width=\"50\" height=\"17\"\r\n                        style=\"max-height: 17px; max-width: 50px; object-fit: contain; margin: 0 8px; display: inline-block; vertical-align: middle;\" />\r\n                    <img src=\"https://es.app.scitoevents.com/static/ckeditor/603e4b3e8a6cd22e42ff4d081a43a32f\"\r\n                        alt=\"Luara\" width=\"50\" height=\"17\"\r\n                        style=\"max-height: 17px; max-width: 50px; object-fit: contain; margin: 0 8px; display: inline-block; vertical-align: middle;\" />\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div style=\"border-top: 1px solid #e2e8f0; padding-top: 10px; text-align: center; margin-top: 12px;\">\r\n            <p style=\"font-size: 10px; color: #94a3b8; margin: 0;\">\r\n                Este es un certificado automático de CIPIE26. Para soporte, contacte a hola@cipie2026.com.\r\n            </p>\r\n        </div>\r\n    </div>\r\n</div>"
