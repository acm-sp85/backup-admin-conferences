    "email_certificate_body": "<style>\r\n    @import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;600;700&display=swap');\r\n</style>\r\n\r\n<div style=\"font-family: 'League Spartan', 'Century Gothic', Verdana, Arial, sans-serif; padding: 30px 40px 20px 40px; margin-top: 100px;\">\r\n\r\n    <div>\r\n        <h1 style=\"text-align: center; color: #1e57a4; font-size: 22px; font-weight: 700; margin: 0 0 6px 0; letter-spacing: 1px;\">CERTIFICADO DE PARTICIPACIÓN</h1>\r\n        <div style=\"text-align: center; border-bottom: 2px solid #1e57a4; padding-bottom: 12px; margin-bottom: 18px;\">\r\n        </div>\r\n        <table style=\"width: 100%; margin-bottom: 18px;\" cellpadding=\"0\" cellspacing=\"0\">\r\n            <tr>\r\n                <td style=\"width: 50%; vertical-align: top; padding-right: 20px;\">\r\n                    <p style=\"font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 3px 0;\">${name}</p>\r\n                    <p style=\"font-size: 12px; color: #64748b; margin: 0 0 2px 0;\">${institution}</p>\r\n                    <p style=\"font-size: 11px; color: #64748b; margin: 0 0 2px 0;\">${entityAddress}</p>\r\n                    <p style=\"font-size: 11px; color: #64748b; margin: 0;\">${entityLocation}</p>\r\n                </td>\r\n                <td style=\"width: 50%; vertical-align: top; padding-left: 20px; border-left: 1px solid #e2e8f0;\">\r\n                    <p style=\"font-size: 10px; font-weight: 700; color: #1e57a4; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 5px 0;\">Este documento certifica la participación en:</p>\r\n                    <p style=\"font-size: 12px; font-weight: 700; color: #1e293b; margin: 0 0 3px 0;\">CIPIE26 - ${conferenceFullName}</p>\r\n                    <p style=\"font-size: 11px; color: #64748b; margin: 0; line-height: 1.35;\">${conferenceAddress}</p>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n        <div style=\"background: #f8fafc; border-radius: 8px; padding: 16px 20px; margin-bottom: 18px; border: 1px solid #e2e8f0;\">\r\n            <p style=\"font-size: 13px; color: #334155; line-height: 1.5; margin: 0;\">\r\n                Se certifica que <strong>${name}</strong> participó ${registrationType} en el <strong>${conferenceFullName} - CIPIE26</strong>, celebrado en <strong>Edificio Alumni, Campus de la Universidad de Navarra en Madrid</strong> del <strong>9 al 11 de Julio de 2026</strong>.\r\n            </p>\r\n            ${presentationsHtml}\r\n        </div>\r\n        <div style=\"margin-bottom: 18px;\">\r\n            <p style=\"font-size: 12px; color: #475569; margin: 0;\">Atentamente,</p>\r\n            ${signatureHtml}\r\n            ${textUnderSignatureHtml}\r\n        </div>\r\n    </div>\r\n\r\n    <div style=\"margin-top: 100px;\">\r\n        <div style=\"border-top: 1px solid #e2e8f0; padding-top: 12px; text-align: center; width: 100%;\">\r\n            <p\r\n                style=\"font-size: 8px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1.5px; margin: 0 0 10px 0;\">\r\n                Organizado y Apoyado por</p>\r\n\r\n            <!-- Tier 1: Organizadores principales -->\r\n            <div style=\"text-align: center; line-height: 38px; margin-bottom: 14px;\">\r\n                <img src=\"https://app.scitoevents.com/static/ckeditor/41f89bd63be6f3a6b3782dee94c3e5d5\" alt=\"UNAV\"\r\n                    width=\"90\" height=\"38\"\r\n                    style=\"max-height: 38px; max-width: 130px; object-fit: contain; margin: 0 14px; display: inline-block; vertical-align: middle;\" />\r\n                <img src=\"https://app.scitoevents.com/static/ckeditor/6b9e66a611046635311c15b2b321d25f\" alt=\"CDPUE\"\r\n                    width=\"112\" height=\"38\"\r\n                    style=\"max-height: 38px; max-width: 130px; object-fit: contain; margin: 0 14px; display: inline-block; vertical-align: middle;\" />\r\n                <img src=\"https://app.scitoevents.com/static/ckeditor/95bc14ad3638a0d0a811d018cba7ab97\" alt=\"COP\"\r\n                    width=\"90\" height=\"38\"\r\n                    style=\"max-height: 38px; max-width: 130px; object-fit: contain; margin: 0 14px; display: inline-block; vertical-align: middle;\" />\r\n                <img src=\"https://app.scitoevents.com/static/ckeditor/0c27574b7668305ab9d401d7e05d12a3\" alt=\"Ametic\"\r\n                    width=\"90\" height=\"38\"\r\n                    style=\"max-height: 38px; max-width: 130px; object-fit: contain; margin: 0 14px; display: inline-block; vertical-align: middle;\" />\r\n\r\n            </div>\r\n\r\n            <!-- Separador ligero entre tiers -->\r\n            <div style=\"width: 50px; height: 1px; background: #e2e8f0; margin: 0 auto 12px auto;\"></div>\r\n\r\n            <!-- Tier 2: Segundo nivel -->\r\n            <div style=\"text-align: center; line-height: 24px; margin-bottom: 12px; opacity: 0.85;\">\r\n                <img src=\"https://es.app.scitoevents.com/static/ckeditor/0105a8c76cdb58c49193f4cfa5891616\"\r\n                    alt=\"CogniFit\" width=\"80\" height=\"24\"\r\n                    style=\"max-height: 24px; max-width: 80px; object-fit: contain; margin: 0 10px; display: inline-block; vertical-align: middle;\" />\r\n                <img src=\"https://es.app.scitoevents.com/static/ckeditor/1708a647f490d43c56ff6df78814fdbb\"\r\n                    alt=\"Nesa World\" width=\"80\" height=\"24\"\r\n                    style=\"max-height: 24px; max-width: 80px; object-fit: contain; margin: 0 10px; display: inline-block; vertical-align: middle;\" />\r\n                <img src=\"https://es.app.scitoevents.com/static/ckeditor/9bd413acc5b6d1fd4179afef39363531\"\r\n                    alt=\"Madrid+de\" width=\"80\" height=\"24\"\r\n                    style=\"max-height: 24px; max-width: 80px; object-fit: contain; margin: 0 10px; display: inline-block; vertical-align: middle;\" />\r\n          